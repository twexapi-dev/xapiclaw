{
  "id": "xapiclaw",
  "name": "XApiClaw",
  "version": "0.1.0",
  "description": "Search tweets, replies, users, followers, trends, lists, communities, DMs, and approved X/Twitter write actions through TwexAPI.",
  "activation": {
    "onStartup": false,
    "onCapabilities": ["tool"]
  },
  "commandAliases": [
    { "name": "xstatus", "kind": "runtime-slash" },
    { "name": "xtrends", "kind": "runtime-slash" }
  ],
  "skills": ["skills/xapiclaw"],
  "contracts": {
    "tools": ["explore", "xapiclaw"]
  },
  "toolMetadata": {
    "xapiclaw": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "minLength": 1,
        "description": "TwexAPI API key. Store as sensitive OpenClaw plugin config."
      },
      "baseUrl": {
        "type": "string",
        "default": "https://api.twexapi.io",
        "pattern": "^https://",
        "description": "HTTPS TwexAPI-compatible API base URL."
      },
      "pollingInterval": {
        "type": "number",
        "default": 60,
        "minimum": 5,
        "description": "Reserved polling interval in seconds."
      },
      "pollingEnabled": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "uiHints": {
    "apiKey": {
      "label": "TwexAPI API Key",
      "sensitive": true,
      "placeholder": "twex_...",
      "help": "Generate from the TwexAPI dashboard."
    },
    "baseUrl": {
      "label": "API Base URL",
      "placeholder": "https://api.twexapi.io",
      "advanced": true,
      "help": "HTTPS only. Change only for a TwexAPI-compatible deployment."
    },
    "pollingInterval": {
      "label": "Event Poll Interval (seconds)",
      "advanced": true,
      "help": "Reserved for future TwexAPI monitor/event endpoints."
    },
    "pollingEnabled": {
      "label": "Enable Event Notifications",
      "advanced": true,
      "help": "Reserved for future TwexAPI monitor/event endpoints."
    }
  }
}
